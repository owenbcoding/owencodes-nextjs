# Site Configuration
NEXT_PUBLIC_SITE_URL=https://owencodes.dev
SITE_URL=https://owencodes.dev

# Resend Email Service
# Get API key from: https://resend.com/api-tokens
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Audience/Segment ID for newsletter subscribers
# Found in Resend dashboard under Audiences
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_SEGMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Resend Email Template IDs
# Create welcome email template in Resend dashboard
RESEND_WELCOME_TEMPLATE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Email Sender Configuration
MAIL_FROM_ADDRESS=contact@owencodes.dev
MAIL_FROM_NAME=Owen
CONTACT_FROM_EMAIL=contact@owencodes.dev
NEWSLETTER_NO_REPLY_FROM=no-reply@owencodes.dev

# GitHub Actions Secrets (set in repository settings)
# Used by newsletter automation workflows
NEWSLETTER_SEND_ENDPOINT=https://owencodes.dev/api/newsletter/send
NEWSLETTER_SEND_TOKEN=your-secret-token-here

# Analytics (Optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id
