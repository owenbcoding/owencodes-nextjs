# Site Configuration
NEXT_PUBLIC_SITE_URL=https://example.com
SITE_URL=https://example.com

# Sanity CMS
# Create these values in https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Resend Email Service 
# Get API key from: https://resend.com/api-tokens
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Audience ID for newsletter subscribers
# Found in Resend dashboard under Audiences
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Resend welcome email template ID
RESEND_WELCOME_TEMPLATE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Email Sender Configuration
MAIL_FROM_ADDRESS=contact@example.com
MAIL_FROM_NAME=Example User
CONTACT_FROM_EMAIL=contact@example.com
CONTACT_MAIL_TO=recipient@example.com
NEWSLETTER_NO_REPLY_FROM=no-reply@example.com

# Used to protect the Sanity Studio at /studio
STUDIO_USERNAME=your-studio-username
STUDIO_PASSWORD=your-studio-password

# Used by newsletter automation workflows
NEWSLETTER_SEND_ENDPOINT=https://example.com/api/newsletter/send
NEWSLETTER_SEND_TOKEN=your-secret-token-here
# Optional separate secret for unsubscribe links
NEWSLETTER_UNSUBSCRIBE_SECRET=your-unsubscribe-signing-secret
